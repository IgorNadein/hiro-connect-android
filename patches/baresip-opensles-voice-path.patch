+}
+
+
+static int startPlayer(struct auplay_st *st)
+{
+	SLresult r;
+
+	/*
+	 * Prime the complete queue before starting playback.  The previous
+	 * one-buffer start left only 10 ms of scheduling headroom and caused
+	 * audible underruns on busy Android devices.
+	 */
+	for (int i = 0; i < N_PLAY_QUEUE_BUFFERS; ++i) {
+		struct auframe af;
+
+		auframe_init(&af, AUFMT_S16LE, st->sampv[i], st->sampc,
+			     st->prm.srate, st->prm.ch);
+		st->wh(&af, st->arg);
+
+		r = (*st->BufferQueue)->Enqueue(st->BufferQueue, st->sampv[i],
+						(unsigned int)(st->sampc * 2));
+		if (SL_RESULT_SUCCESS != r)
+			return ENODEV;
+	}
+	st->bufferId = 0;
+
 	r = (*st->bqPlayerPlay)->SetPlayState(st->bqPlayerPlay,
 					      SL_PLAYSTATE_PLAYING);
-	if (SL_RESULT_SUCCESS != r)
-		return ENODEV;
-
-	return 0;
+	return SL_RESULT_SUCCESS == r ? 0 : ENODEV;
 }
 
 
